# Copy to .env and edit. Never commit .env (it is gitignored).

# --- storage ---
DATA_DIR=data
DB_PATH=data/autolect.db
AUDIO_DIR=data/audio

# --- auth (enforced in phase e) ---
APP_PASSWORD=changeme
SESSION_SECRET=change-me-to-a-long-random-string
LOGIN_RATE_LIMIT_PER_MIN=5

# --- transcription / faster-whisper (phase c) ---
# Benchmarked on Apple M4: `small` on `mps` (int8) ~1.6x realtime with proper
# casing/punctuation. Set WHISPER_DEVICE=cpu if the experimental Metal backend
# misbehaves (cpu `small` still runs ~1.2x realtime).
WHISPER_MODEL=small
WHISPER_DEVICE=mps
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE_FALLBACK=cpu
WHISPER_BEAM_SIZE=1

# --- notes / Claude (phase d) ---
ANTHROPIC_API_KEY=
LIVE_MODEL=claude-haiku-4-5
FINAL_MODEL=claude-sonnet-4-6
NOTES_UPDATE_INTERVAL_SEC=60
MIN_NEW_WORDS_FOR_UPDATE=25
PER_LECTURE_BUDGET_USD=2.0
USE_BATCH_API_FOR_FINAL=false
